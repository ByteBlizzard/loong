    let r: Bool = starts("hello", "he")
}

test "ends" target: loong.core.ends {
    let r: Bool = ends("hello", "lo")
}

test "trimmed" target: loong.core.trimmed {
    let r: String = trimmed("  x  ")
}

test "isDigit" target: loong.core.isDigit {
    let a: Bool = isDigit('5')
    let b: Bool = isDigit('x')
}

test "isLetter" target: loong.core.isLetter {
    let a: Bool = isLetter('q')
    let b: Bool = isLetter('5')
}

test "toFloat" target: loong.core.toFloat {
    let r: Float = toFloat(3)
}

test "round" target: loong.core.round {
    let r: Int = round(2.9)
}

test "nearEq" target: loong.core.nearEq {
    let r: Bool = nearEq(0.1 + 0.2, 0.3, 0.0001)
}

test "divOr" target: loong.core.divOr {
    let a: Int = divOr(10, 2, -1)
    let b: Int = divOr(10, 0, -1)
}

test "modOr" target: loong.core.modOr {
    let a: Int = modOr(10, 3, -1)
    let b: Int = modOr(10, 0, -1)
}

external java "java.lang.Character" {
    static function isWhitespace(c: Char) -> Bool
    static function isUpperCase(c: Char) -> Bool
    static function isLowerCase(c: Char) -> Bool
    static function ctu(c: Char) -> Char as "toUpperCase"
    static function ctl(c: Char) -> Char as "toLowerCase"
}

/// True when c is whitespace (Unicode).
public function isSpace(c: Char) -> Bool {
    return isWhitespace(c)
}

/// True when c is uppercase (Unicode).
public function isUpper(c: Char) -> Bool {
    return isUpperCase(c)
}

/// True when c is lowercase (Unicode).
public function isLower(c: Char) -> Bool {
    return isLowerCase(c)
}

/// Uppercased copy of c (Unicode).
public function toUpper(c: Char) -> Char {
    return ctu(c)
}

/// Lowercased copy of c (Unicode).
public function toLower(c: Char) -> Char {
    return ctl(c)
}

test "isSpace" target: loong.core.isSpace {
    let a: Bool = isSpace(' ')
    let b: Bool = isSpace('x')
}

test "isUpper" target: loong.core.isUpper {
    let a: Bool = isUpper('A')
    let b: Bool = isUpper('a')
}

test "isLower" target: loong.core.isLower {
    let a: Bool = isLower('a')
}

