module demo.structs

/// A mutable point.
public struct Point {
    /// x coordinate
    x: Int
    /// y coordinate
    y: Int
}

/// Entry point.
function main() -> Unit {
    var p: Point = Point(x: 3, y: 4)
    let dist2: Int = p.x * p.x + p.y * p.y
    p.x = 10
    println(str(dist2))
    println(str(p.x + p.y))
}
